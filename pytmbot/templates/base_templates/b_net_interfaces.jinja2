{# templates/b_net_interfaces.jinja2 — rich HTML #}
<p><b>{{ thought_balloon }} Network Interfaces</b></p>

{% if context.interfaces %}
<table bordered striped>
<tr>
<th>Name</th>
<th>State</th>
<th align="right">Speed</th>
<th align="right">MTU</th>
<th>IPv4</th>
</tr>
{% for item in context.interfaces %}
<tr>
<td>{{ item.name|e }}</td>
<td>{{ item.state|e }}</td>
<td align="right">{{ item.speed|e }}</td>
<td align="right">{{ item.mtu|e }}</td>
<td>{{ item.ip_address|e }}</td>
</tr>
{% endfor %}
</table>
{% else %}
<p>No network interface data available.</p>
{% endif %}
