{# templates/b_cpu.jinja2 — rich HTML #}
<p><b>⚡ CPU</b></p>

<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="right">Value</th></tr>
<tr><td>Total usage</td><td align="right">{{ "%.1f"|format(context.cpu_percent) }}%</td></tr>
<tr><td>Logical cores</td><td align="right">{{ context.logical_cores|e }}</td></tr>
<tr><td>Physical cores</td><td align="right">{{ context.physical_cores|e }}</td></tr>
</table>

<p><b>Frequency</b></p>
{% if context.current_freq_mhz > 0 %}
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="right">Value</th></tr>
<tr><td>Current</td><td align="right">{{ "%.1f"|format(context.current_freq_mhz) }} MHz</td></tr>
<tr><td>Min</td><td align="right">{{ "%.1f"|format(context.min_freq_mhz) }} MHz</td></tr>
<tr><td>Max</td><td align="right">{{ "%.1f"|format(context.max_freq_mhz) }} MHz</td></tr>
</table>
{% else %}
<p><i>CPU frequency data is not available.</i></p>
{% endif %}

{% if running_in_docker %}
<p>{{ warning }} <i>Limited resource information available in Docker environment</i></p>
{% endif %}
