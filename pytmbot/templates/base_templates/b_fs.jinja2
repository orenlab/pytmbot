{# templates/b_fs.jinja2 — rich HTML #}
<p><b>💾 File system</b></p>

{% for value in context %}
<p><b>{{ value['device_name']|e }}</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
<tr><td>Type</td><td>{{ value['fs_type']|e }}</td></tr>
<tr><td>Mount</td><td>{{ value['mnt_point']|e }}</td></tr>
<tr><td>Size</td><td>{{ value['size']|e }}</td></tr>
<tr><td>Used</td><td>{{ value['used']|e }} ({{ value['percent']|e }}%)</td></tr>
<tr><td>Free</td><td>{{ value['free']|e }}</td></tr>
</table>
{% endfor %}
{% if running_in_docker %}
<p>{{ warning }} <i>Limited resource information available in Docker environment</i></p>
{% endif %}
