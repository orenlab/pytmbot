{# plugin_outline_traffic.jinja2 — rich HTML #}
{% set bytes_transferred = context['bytesTransferredByUserId'] %}
{% set user_names = context['userNames'] %}

<p><b>{{ thought_balloon }} {{ first_name|e }}</b></p>

<p><b>Bytes transferred by users</b></p>
{% if bytes_transferred %}
<ul>
{% for user_id, bytes in bytes_transferred.items() %}
{% set user_name = user_names.get(user_id, 'Unknown') %}
<li><i>{{ user_name|e }} (User ID {{ user_id|e }}): {{ set_naturalsize(bytes if bytes else 0)|e }}</i></li>
{% endfor %}
</ul>
{% else %}
<p><i>No data available.</i></p>
{% endif %}
