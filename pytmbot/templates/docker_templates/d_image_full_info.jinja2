{# d_image_full_info.jinja2 — rich HTML #}
<p><b>🖼️ Image details</b></p>

<p><b>{{ context.image.name|e }}</b></p>
<p><b>ID:</b> <code>{{ context.image.id|e }}</code></p>

<p><b>Identity</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
<tr><td>Tags</td><td>{{ context.image.tags | map('e') | join(", ") if context.image.tags_count > 0 else "none" }}</td></tr>
<tr><td>Repo digests</td><td>{{ context.image.repo_digests | map('e') | join(", ") if context.image.repo_digests_count > 0 else "none" }}</td></tr>
<tr><td>Parent</td><td>{{ context.image.parent_id|e }}</td></tr>
</table>

<p><b>Platform and size</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
<tr><td>Platform</td><td>{{ context.image.os|e }}/{{ context.image.architecture|e }}{% if context.image.variant != "N/A" %} ({{ context.image.variant|e }}){% endif %}</td></tr>
<tr><td>Size</td><td>{{ context.image.size|e }}</td></tr>
<tr><td>Virtual</td><td>{{ context.image.virtual_size|e }}</td></tr>
{% if context.image.shared_size != "N/A" %}<tr><td>Shared</td><td>{{ context.image.shared_size|e }}</td></tr>{% endif %}
<tr><td>Layers</td><td>{{ context.image.layers_count|e }}</td></tr>
<tr><td>RootFS</td><td>{{ context.image.rootfs_type|e }}</td></tr>
<tr><td>Created</td><td>{{ context.image.created|e }}{% if context.image.created_at != "N/A" %} ({{ context.image.created_at|e }}){% endif %}</td></tr>
</table>

<p><b>Runtime defaults</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
<tr><td>User</td><td>{{ context.image.user|e }}</td></tr>
<tr><td>WorkDir</td><td>{{ context.image.working_dir|e }}</td></tr>
<tr><td>Stop signal</td><td>{{ context.image.stop_signal|e }}</td></tr>
<tr><td>Entrypoint</td><td>{{ context.image.entrypoint | map('e') | join(" ") if context.image.entrypoint else "none" }}</td></tr>
<tr><td>Command</td><td>{{ context.image.cmd | map('e') | join(" ") if context.image.cmd else "none" }}</td></tr>
<tr><td>Shell</td><td>{{ context.image.shell | map('e') | join(" ") if context.image.shell else "none" }}</td></tr>
<tr><td>Healthcheck</td><td>{{ context.image.healthcheck|e }}</td></tr>
</table>

<p><b>Network and storage</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
<tr><td>Exposed ports{% if context.image.exposed_ports_count > 0 %} ({{ context.image.exposed_ports_count|e }}){% endif %}</td><td>{{ context.image.exposed_ports | map('e') | join(", ") if context.image.exposed_ports_count > 0 else "none" }}</td></tr>
<tr><td>Declared volumes{% if context.image.volumes_count > 0 %} ({{ context.image.volumes_count|e }}){% endif %}</td><td>{{ context.image.volumes | map('e') | join(", ") if context.image.volumes_count > 0 else "none" }}</td></tr>
</table>
<p><b>Env vars{% if context.image.env_variables_count > 0 %} ({{ context.image.env_variables_count|e }}){% endif %}:</b></p>
{% if context.image.env_variables_count > 0 %}
<pre><code>{% for env_var in context.image.env_variables %}{{ env_var|e }}
{% endfor %}</code></pre>
{% else %}
<p><code>none</code></p>
{% endif %}

<p><b>Metadata</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
<tr><td>Author</td><td>{{ context.image.author|e }}</td></tr>
<tr><td>Docker version</td><td>{{ context.image.docker_version|e }}</td></tr>
{% if context.image.comment != "N/A" %}<tr><td>Comment</td><td>{{ context.image.comment|e }}</td></tr>{% endif %}
</table>
<p><b>Labels{% if context.image.label_count > 0 %} ({{ context.image.label_count|e }}){% endif %}:</b></p>
{% if context.image.labels %}
<ul>
{% for label_key, label_value in context.image.labels.items() %}
{% if label_key == "__truncated__" %}
<li><i>... {{ label_value|e }}</i></li>
{% else %}
<li><code>{{ label_key|e }}</code>=<code>{{ label_value|e }}</code></li>
{% endif %}
{% endfor %}
</ul>
{% else %}
<p><code>none</code></p>
{% endif %}
