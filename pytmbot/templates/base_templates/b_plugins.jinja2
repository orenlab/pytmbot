{# b_plugins.jinja2 — rich HTML #}
<p><b>🧩 Plugins</b></p>

{% if plugins %}
<ul>
{% for plugin_name, plugin_description in plugins.items() %}
<li><b>{{ plugin_name|e }}</b> — {{ plugin_description|e }}</li>
{% endfor %}
</ul>

<p><i>Open a plugin from the menu below.</i></p>
{% else %}
<p>No plugins are enabled.</p>

<p><i>Start pyTMBot with <code>--plugins monitor outline</code> to enable the bundled plugins.</i></p>
{% endif %}
