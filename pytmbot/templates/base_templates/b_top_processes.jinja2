{# templates/b_top_processes.jinja2 — rich HTML #}
<p><b>{{ thought_balloon }} System Resource Usage – Top Processes</b></p>

{% if context.process_rows %}
<table bordered striped>
<tr>
<th>PID</th>
<th>Process</th>
<th align="right">CPU</th>
<th align="right">MEM</th>
</tr>
{% for row in context.process_rows %}
<tr>
<td>{{ row.pid|e }}</td>
<td>{{ row.name|e }}</td>
<td align="right">{{ "%.1f"|format(row.cpu_percent) }}%</td>
<td align="right">{{ "%.1f"|format(row.memory_percent) }}%</td>
</tr>
{% endfor %}
</table>
{% else %}
<p>No process data available.</p>
{% endif %}

<footer>{{ information }} Updated: {{ context.timestamp|e }}</footer>
{%- if context.running_in_docker %}
<p>{{ warning }} <i>Limited resource information available in Docker environment</i></p>
{%- endif %}
