{# plugin_monitor_metric.jinja2 — rich HTML #}
<p><b>📊 {{ title|e }}</b></p>
<p>Period: <b>{{ period_label|e }}</b></p>

{% if summary_lines %}
<p><b>Summary</b></p>
<ul>
{% for line in summary_lines %}
<li>{{ line|e }}</li>
{% endfor %}
</ul>
{% else %}
<p>⚠️ <i>No metrics found for this period.</i></p>
{% endif %}

{% if detail_lines %}
<p><b>Details</b></p>
<ul>
{% for line in detail_lines %}
<li>{{ line|e }}</li>
{% endfor %}
</ul>
{% endif %}

<p><i>Use Select period to change the time range.</i></p>
