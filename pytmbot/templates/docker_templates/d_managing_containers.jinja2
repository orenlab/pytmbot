{# templates/docker_templates/d_managing_containers.jinja2 — rich HTML #}
<p><b>{{ emojis['thought_balloon'] }} Container actions</b></p>

<table bordered striped>
<tr><th>Parameter</th><th>Value</th></tr>
<tr><td>{{ emojis['briefcase'] }} Container</td><td><code>{{ container_name|e }}</code></td></tr>
<tr><td>State</td><td><code>{{ state|e }}</code></td></tr>
</table>

<p>{{ emojis['anxious_face_with_sweat'] }} <b>Changes here affect the live container immediately.</b></p>

<details>
<summary>What each action does</summary>
<ul>
<li><b>Start</b> — start the container with its last set of arguments</li>
<li><b>Stop</b> — stop the running container</li>
<li><b>Restart</b> — restart the container with its last startup parameters</li>
</ul>
</details>

<p><i>Available actions depend on the current container state. Choose one below.</i></p>
