{# templates/docker_templates/d_containers.jinja2 — rich HTML #}
{% set container_fields = [
    ('Status', 'status'),
    ('Image', 'image'),
    ('ID', 'id'),
    ('Started', 'run_at'),
    ('Created', 'created')
] %}
<p><b>📦 Containers</b></p>

{% for value in context %}
<p><b>{{ value['name']|e }}</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
{% for label, field_key in container_fields %}
{% set field_value = value[field_key] if value[field_key] is not none else 'N/A' %}
<tr><td>{{ label }}</td><td>{% if field_key in ('id', 'status') %}<code>{{ field_value|e }}</code>{% else %}{{ field_value|e }}{% endif %}</td></tr>
{% endfor %}
</table>
{% else %}
<p>No containers found. If you expected some, check that pyTMBot can reach the Docker socket.</p>
{% endfor %}
{% if context %}

<p><i>Tap a container below to open its details.</i></p>
{% endif %}
