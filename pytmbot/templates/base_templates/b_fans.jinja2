{# templates/b_fans.jinja2 — rich HTML #}
<p><b>{{ thought_balloon }} Fan Speeds</b></p>

{% if context.fans %}
<table bordered striped>
<tr><th>Fan</th><th align="right">RPM</th></tr>
{% for fan in context.fans %}
<tr>
<td>{{ fan.sensor_name|e }} / {{ fan.label|e }}</td>
<td align="right">{{ fan.rpm|e }}</td>
</tr>
{% endfor %}
</table>
{% else %}
<p>No fan speed data available.</p>
{% endif %}
