{# templates/b_getmyid.jinja2 — rich HTML #}
<p><b>🆔 ID Information</b></p>

<p>Hello, <b>{{ first_name|e }}{% if last_name %} {{ last_name|e }}{% endif %}</b>!</p>
{% if is_bot_admin %}
<p>✅ You are authorized to use this bot.</p>
{% else %}
<p>⚠️ You are not currently authorized to use this bot.</p>
{% endif %}

<p><b>👤 User</b></p>
<table bordered striped>
<tr><th>Parameter</th><th>Value</th></tr>
<tr><td>User ID</td><td><code>{{ user_id|e }}</code></td></tr>
<tr><td>First name</td><td>{{ first_name|e }}</td></tr>
{% if last_name %}
<tr><td>Last name</td><td>{{ last_name|e }}</td></tr>
{% endif %}
{% if username %}
<tr><td>Username</td><td>@{{ username|e }}</td></tr>
{% endif %}
{% if is_bot_admin %}
<tr><td>Status</td><td>Bot administrator ⭐</td></tr>
{% endif %}
</table>

<p><b>💬 Chat</b></p>
<table bordered striped>
<tr><th>Parameter</th><th>Value</th></tr>
<tr><td>Chat ID</td><td><code>{{ chat_id|e }}</code></td></tr>
<tr><td>Chat type</td><td>{{ chat_type|e }}</td></tr>
{% if chat_title %}
<tr><td>Chat title</td><td>{{ chat_title|e }}</td></tr>
{% endif %}
</table>

<p><b>📋 Configuration notes</b></p>
<ul>
<li>Use the User ID to set up admin privileges</li>
<li>Use the Chat ID to configure allowed chats</li>
<li>Copy these values to your bot configuration file</li>
</ul>

<footer>🔒 This message is deleted automatically after {{ auto_delete_delay|e }} seconds for privacy.</footer>
