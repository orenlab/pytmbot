{# d_containers_full_info.jinja2 — rich HTML #}
{% macro kv_row(label, value, align_right=False) -%}
{%- set text = value if value is not none else '' -%}
{%- set text = text|string|trim -%}
{%- if text -%}
<tr><td>{{ label|e }}</td><td{% if align_right %} align="right"{% endif %}>{{ text|e }}</td></tr>
{%- endif -%}
{%- endmacro %}

<p><b>📦 Container details</b></p>

<p><b>{{ name|e }}</b> · {{ status_badge|e }} · {{ health_badge|e }}</p>

<p><b>Basic info</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
{{ kv_row('Name', name) }}
{{ kv_row('ID', id) }}
{{ kv_row('Image', image_name ~ ':' ~ image_tag) }}
{{ kv_row('Uptime', uptime) }}
{{ kv_row('Started', started_at) }}
{%- if finished_at and finished_at|string|trim and finished_at|string|trim != 'N/A' -%}
{{ kv_row('Finished', finished_at) }}
{%- endif -%}
{{ kv_row('Restarts', restart_count) }}
{{ kv_row('PID', pid) }}
</table>

<p><b>Resource limits</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
{{ kv_row('Memory', resources.memory_limit) }}
{{ kv_row('Memory reservation', resources.memory_reservation) }}
{{ kv_row('CPU Quota', resources.cpu_quota) }}
{{ kv_row('CPU limit', resources.cpus_limit) }}
{{ kv_row('CPU Set', resources.cpuset_cpus) }}
{{ kv_row('PIDs limit', resources.pids_limit) }}
{{ kv_row('Restart Policy', resources.restart_policy) }}
{{ kv_row('Max retries', resources.max_restart_count) }}
{{ kv_row('Memory headroom', resources.memory_headroom) }}
</table>

{% if stats.memory %}
<p><b>Current usage</b></p>
<table bordered striped compact>
<tr><th align="left">Metric</th><th align="left">Value</th></tr>
<tr><td>Memory</td><td>{{ stats.memory.mem_usage|e }} / {{ stats.memory.mem_limit|e }} ({% if stats.memory.mem_percent == 'N/A' %}N/A{% else %}{{ stats.memory.mem_percent|e }}%{% endif %})</td></tr>
{% if stats.cpu.cpu_percent %}{{ kv_row('CPU', stats.cpu.cpu_percent ~ '%') }}{% endif %}
{% if stats.network %}
<tr><td>Network I/O</td><td>↓{{ stats.network.rx_bytes|e }} ↑{{ stats.network.tx_bytes|e }}</td></tr>
{% if stats.network.rx_errors or stats.network.tx_errors %}
<tr><td>Network errors</td><td>RX {{ stats.network.rx_errors|e }} | TX {{ stats.network.tx_errors|e }}</td></tr>
{% endif %}
{% endif %}
{% if stats.cpu.throttled_periods %}{{ kv_row('CPU throttled', stats.cpu.throttled_periods ~ ' periods') }}{% endif %}
</table>
{% endif %}

<p><b>Runtime state</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
{{ kv_row('Health failing streak', health_failing_streak) }}
{{ kv_row('Last health check', health_last_checked_at) }}
<tr><td>OOM killed</td><td>{% if oom_killed %}yes{% else %}no{% endif %}</td></tr>
<tr><td>Dead</td><td>{% if dead %}yes{% else %}no{% endif %}</td></tr>
{{ kv_row('State error', state_error) }}
</table>

<p><b>Network</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
{{ kv_row('Mode', network.network_mode) }}
<tr><td>Published ports</td><td>{{ network.published_ports|e }} / {{ network.declared_ports|e }}</td></tr>
{% if network.ports %}<tr><td>Ports</td><td>{% for port in network.ports %}{{ port|e }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>{% endif %}
{% if network.networks %}<tr><td>Networks</td><td>{% for net in network.networks %}{{ net|e }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>{% endif %}
</table>

<p><b>Configuration</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
{{ kv_row('User', environment.user) }}
{{ kv_row('WorkDir', environment.working_dir) }}
{% if environment.entrypoint != 'N/A' %}{{ kv_row('Entrypoint', environment.entrypoint) }}{% endif %}
{% if environment.command != 'N/A' %}{{ kv_row('Command', environment.command) }}{% endif %}
</table>

<p><b>Environment* ({{ environment.env_count|e }} vars)</b></p>
<pre><code>{% if environment.environment_vars %}{% for var in environment.environment_vars %}{{ var|e }}
{% endfor %}{% else %}No environment variables{% endif %}</code></pre>
<p><i>*Sensitive data is hidden</i></p>

<p><i>Use the buttons below for logs, runtime details, networks, volumes and actions.</i></p>
