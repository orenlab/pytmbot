{# templates/b_quick_view.jinja2 — rich HTML #}
{% macro value_or_na(value, suffix='') -%}
{%- if value is not none %}{{ value|e }}{{ suffix }}{% else %}N/A{% endif -%}
{%- endmacro %}
{% macro number_or_na(value, pattern, suffix='') -%}
{%- if value is not none %}{{ pattern|format(value) }}{{ suffix }}{% else %}N/A{% endif -%}
{%- endmacro %}
<p><b>👀 Quick view</b></p>

{% if context.system %}
{% set system = context.system %}
{% set load = system.load_average or [none, none, none] %}
<p><b>System</b></p>
<table bordered striped compact>
<tr><th align="left">Metric</th><th align="right">Value</th></tr>
<tr><td>Uptime</td><td align="right">{{ value_or_na(system.uptime) }}</td></tr>
<tr><td>Load 1 / 5 / 15 min</td><td align="right">{{ number_or_na(load[0], "%.2f") }} / {{ number_or_na(load[1], "%.2f") }} / {{ number_or_na(load[2], "%.2f") }}</td></tr>
</table>

<p><b>CPU and memory</b></p>
<table bordered striped compact>
<tr><th align="left">Metric</th><th align="right">Value</th></tr>
<tr><td>CPU usage</td><td align="right">{{ number_or_na(system.cpu.cpu_percent if system.cpu else none, "%.1f", "%") }}</td></tr>
<tr><td>CPU cores</td><td align="right">{{ value_or_na(system.cpu.cpu_count if system.cpu else none) }}</td></tr>
<tr><td>CPU frequency</td><td align="right">{{ number_or_na(system.cpu.frequency_mhz if system.cpu else none, "%.0f", " MHz") }}</td></tr>
<tr><td>Memory usage</td><td align="right">{{ value_or_na(system.memory.percent if system.memory else none, "%") }}</td></tr>
<tr><td>Memory used</td><td align="right">{{ value_or_na(system.memory.used if system.memory else none) }}</td></tr>
<tr><td>Memory free</td><td align="right">{{ value_or_na(system.memory.free if system.memory else none) }}</td></tr>
</table>

<p><b>Processes</b></p>
<table bordered striped compact>
<tr><th align="left">State</th><th align="right">Count</th></tr>
<tr><td>Running</td><td align="right">{{ value_or_na(system.processes.running if system.processes else none) }}</td></tr>
<tr><td>Sleeping</td><td align="right">{{ value_or_na(system.processes.sleeping if system.processes else none) }}</td></tr>
<tr><td>Idle</td><td align="right">{{ value_or_na(system.processes.idle if system.processes else none) }}</td></tr>
<tr><td>Total</td><td align="right">{{ value_or_na(system.processes.total if system.processes else none) }}</td></tr>
</table>
{% else %}
<p>⚠️ <i>System metrics are unavailable right now.</i></p>
{% endif %}

{% if context.docker %}
<p><b>Docker</b></p>
<table bordered striped compact>
<tr><th align="left">Resource</th><th align="right">Count</th></tr>
<tr><td>Running containers</td><td align="right">{{ value_or_na(context.docker.containers_count) }}</td></tr>
<tr><td>Images</td><td align="right">{{ value_or_na(context.docker.images_count) }}</td></tr>
</table>
{% endif %}
{% if updated_at %}

<footer>Updated {{ updated_at|e }}</footer>
{% endif %}
