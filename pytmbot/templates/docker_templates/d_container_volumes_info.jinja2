{# d_container_volumes_info.jinja2 — rich HTML #}
<p><b>{{ thought_balloon }} Container Volumes</b></p>

<p>{{ package_emoji }} <b>Container:</b> <code>{{ container_name|e }}</code></p>

{% if mounts_count > 0 %}
<p><b>{{ luggage_emoji }} Active mounts (showing {{ mounts_count|e }} of {{ mounts_total|e }})</b></p>
{% for mount in mounts %}
<p><b>{{ loop.index }}. <code>{{ mount.type|e }}</code>{% if mount.name != '-' %} <code>{{ mount.name|e }}</code>{% endif %}</b></p>
<table bordered striped>
<tr><td>Source</td><td>{{ mount.source|e }}</td></tr>
<tr><td>Target</td><td>{{ mount.destination|e }}</td></tr>
<tr><td>Access</td><td>{{ mount.access|e }}</td></tr>
<tr><td>Mode</td><td>{{ mount.mode|e }}</td></tr>
<tr><td>Propagation</td><td>{{ mount.propagation|e }}</td></tr>
<tr><td>Driver</td><td>{{ mount.driver|e }}</td></tr>
</table>
{% endfor %}
{% if hidden_mounts_count > 0 %}
<p><i>... and {{ hidden_mounts_count|e }} more mounts</i></p>
{% endif %}
{% else %}
<p><b>No mounts configured for this container.</b></p>
{% endif %}

<p><b>{{ backpack_emoji }} Declared image volumes{% if declared_volumes_count > 0 %} ({{ declared_volumes_count|e }}){% endif %}</b></p>
{% if declared_volumes_count > 0 %}
<ul>
{% for volume in declared_volumes %}
<li><code>{{ volume|e }}</code></li>
{% endfor %}
</ul>
{% if hidden_declared_volumes_count > 0 %}
<p><i>... and {{ hidden_declared_volumes_count|e }} more declared volumes</i></p>
{% endif %}
{% else %}
<p><code>none</code></p>
{% endif %}

<p><b>{{ chart_emoji }} Host volume directives</b></p>
<p><b>Binds:</b></p>
{% if bind_specs_count > 0 %}
<ul>
{% for bind in bind_specs %}
<li><code>{{ bind|e }}</code></li>
{% endfor %}
</ul>
{% if hidden_bind_specs_count > 0 %}
<p><i>... and {{ hidden_bind_specs_count|e }} more bind directives</i></p>
{% endif %}
{% else %}
<p><code>none</code></p>
{% endif %}

<p><b>VolumesFrom:</b></p>
{% if volumes_from_count > 0 %}
<ul>
{% for parent in volumes_from %}
<li><code>{{ parent|e }}</code></li>
{% endfor %}
</ul>
{% if hidden_volumes_from_count > 0 %}
<p><i>... and {{ hidden_volumes_from_count|e }} more entries</i></p>
{% endif %}
{% else %}
<p><code>none</code></p>
{% endif %}

<p><b>Tmpfs:</b></p>
{% if tmpfs_mounts_count > 0 %}
<ul>
{% for tmpfs in tmpfs_mounts %}
<li><code>{{ tmpfs|e }}</code></li>
{% endfor %}
</ul>
{% if hidden_tmpfs_mounts_count > 0 %}
<p><i>... and {{ hidden_tmpfs_mounts_count|e }} more tmpfs directives</i></p>
{% endif %}
{% else %}
<p><code>none</code></p>
{% endif %}

<p>{{ banjo }} <i>Container volume details retrieved.</i></p>
