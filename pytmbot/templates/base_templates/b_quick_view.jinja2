{# templates/b_quick_view.jinja2 — rich HTML #}
<p><b>📊 System Status Overview</b></p>

{% if context.system %}
<p><b>🖥️ System Resources</b></p>
<table bordered striped>
<tr><th>Metric</th><th align="right">Value</th></tr>
<tr><td>⏱️ Uptime</td><td align="right">{{ (context.system.uptime if context.system.uptime is not none else 'N/A')|e }}</td></tr>
<tr><td>📈 Load 1 min</td><td align="right">{% if context.system.load_average and context.system.load_average[0] is not none %}{{ "%.2f"|format(context.system.load_average[0]) }}{% else %}N/A{% endif %}</td></tr>
<tr><td>📈 Load 5 min</td><td align="right">{% if context.system.load_average and context.system.load_average[1] is not none %}{{ "%.2f"|format(context.system.load_average[1]) }}{% else %}N/A{% endif %}</td></tr>
<tr><td>📈 Load 15 min</td><td align="right">{% if context.system.load_average and context.system.load_average[2] is not none %}{{ "%.2f"|format(context.system.load_average[2]) }}{% else %}N/A{% endif %}</td></tr>
<tr><td>⚡ CPU Load</td><td align="right">{% if context.system.cpu and context.system.cpu.cpu_percent is not none %}{{ "%.1f"|format(context.system.cpu.cpu_percent) }}%{% else %}N/A{% endif %}</td></tr>
<tr><td>⚡ CPU Cores</td><td align="right">{{ (context.system.cpu.cpu_count if context.system.cpu and context.system.cpu.cpu_count is not none else 'N/A')|e }}</td></tr>
<tr><td>⚡ CPU Freq</td><td align="right">{% if context.system.cpu and context.system.cpu.frequency_mhz is not none %}{{ "%.0f"|format(context.system.cpu.frequency_mhz) }}MHz{% else %}N/A{% endif %}</td></tr>
<tr><td>🧠 Memory Used</td><td align="right">{{ (context.system.memory.used if context.system.memory and context.system.memory.used is not none else 'N/A')|e }}</td></tr>
<tr><td>🧠 Memory Free</td><td align="right">{{ (context.system.memory.free if context.system.memory and context.system.memory.free is not none else 'N/A')|e }}</td></tr>
<tr><td>🧠 Memory Usage</td><td align="right">{% if context.system.memory and context.system.memory.percent is not none %}{{ context.system.memory.percent }}%{% else %}N/A{% endif %}</td></tr>
<tr><td>⚙️ Running</td><td align="right">{{ (context.system.processes.running if context.system.processes and context.system.processes.running is not none else 'N/A')|e }}</td></tr>
<tr><td>⚙️ Sleeping</td><td align="right">{{ (context.system.processes.sleeping if context.system.processes and context.system.processes.sleeping is not none else 'N/A')|e }}</td></tr>
<tr><td>⚙️ Idle</td><td align="right">{{ (context.system.processes.idle if context.system.processes and context.system.processes.idle is not none else 'N/A')|e }}</td></tr>
<tr><td>⚙️ Total</td><td align="right">{{ (context.system.processes.total if context.system.processes and context.system.processes.total is not none else 'N/A')|e }}</td></tr>
</table>
{% else %}
<p>⚠️ System monitoring data is currently unavailable</p>
{% endif %}

{% if context.docker %}
<p><b>🐳 Docker Environment</b></p>
<table bordered striped>
<tr><th>Metric</th><th align="right">Value</th></tr>
<tr><td>Active Containers</td><td align="right">{{ (context.docker.containers_count if context.docker.containers_count is not none else 'N/A')|e }}</td></tr>
<tr><td>Available Images</td><td align="right">{{ (context.docker.images_count if context.docker.images_count is not none else 'N/A')|e }}</td></tr>
</table>
{% endif %}
