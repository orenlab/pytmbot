{# plugin_monitor_index.jinja2 — rich HTML #}
<p><b>📊 Monitoring</b></p>
<p>Period: <b>{{ period_label|e }}</b></p>

{% if notice %}
<p>✅ {{ notice|e }}</p>
{% endif %}

<p><b>Summary</b></p>
<table bordered striped compact>
<tr><th align="left">Metric</th><th align="left">Value</th></tr>
<tr><td>CPU</td><td>{{ cpu_line|e }}</td></tr>
<tr><td>Memory</td><td>{{ memory_line|e }}</td></tr>
<tr><td>Disk</td><td>{{ disk_line|e }}</td></tr>
<tr><td>Temperatures</td><td>{{ temperature_line|e }}</td></tr>
</table>

<p><i>Pick a section from the menu below for detailed statistics from InfluxDB.</i></p>
