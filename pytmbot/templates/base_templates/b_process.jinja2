{# templates/b_process.jinja2 — rich HTML #}
<p><b>⚙️ Processes</b></p>

{% if context %}
<table bordered striped compact>
<tr><th align="left">State</th><th align="right">Count</th></tr>
{% for key, value in context.items() %}
<tr>
<td>{{ key|e }}</td>
<td align="right">{{ value|e }}</td>
</tr>
{% endfor %}
</table>
{% else %}
<p>{{ warning }} <i>Process data is unavailable right now.</i></p>
{% endif %}

{% if running_in_docker %}
<p>{{ warning }} <i>Limited resource information available in Docker environment</i></p>
{% endif %}
