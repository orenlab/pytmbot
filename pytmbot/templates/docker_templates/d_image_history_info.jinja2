{# d_image_history_info.jinja2 — rich HTML #}
<p><b>{{ context.emojis.thought_balloon }} Image History</b></p>

<p><b>{{ context.emojis.package }} {{ context.image_name|e }}</b></p>
<p>{{ context.emojis.spouting_whale }} <b>ID:</b> <code>{{ context.image_id|e }}</code></p>

<p><b>Layers{% if context.layers_count > 0 %} ({{ context.layers_count|e }}){% endif %}</b></p>
{% if context.layers %}
{% for layer in context.layers %}
<p><b>{{ loop.index }}. <code>{{ layer.id|e }}</code></b></p>
<table bordered striped>
<tr><td>Created</td><td>{{ layer.created|e }}</td></tr>
<tr><td>Size</td><td>{{ layer.size|e }}</td></tr>
<tr><td>By</td><td>{{ layer.created_by|e }}</td></tr>
{% if layer.comment %}<tr><td>Comment</td><td>{{ layer.comment|e }}</td></tr>{% endif %}
</table>
{% endfor %}
{% if context.hidden_layers_count > 0 %}
<p><i>... and {{ context.hidden_layers_count|e }} more layers</i></p>
{% endif %}
{% else %}
<p><code>No history available</code></p>
{% endif %}

<p>{{ context.emojis.minus }} <i>Image history retrieved.</i></p>
