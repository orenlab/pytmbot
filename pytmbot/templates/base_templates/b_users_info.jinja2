{# templates/b_users_info.jinja2 — rich HTML #}
<p><b>{{ thought_balloon }} Active Sessions</b></p>

{% if context.users %}
<table bordered striped>
<tr>
<th>User</th>
<th>Terminal</th>
<th>Host</th>
<th>Started</th>
</tr>
{% for user in context.users %}
<tr>
<td>{{ user.username|e }}</td>
<td>{{ user.terminal|e }}</td>
<td>{{ user.host|e }}</td>
<td>{{ user.started_at|e }} ({{ user.started_ago|e }})</td>
</tr>
{% endfor %}
</table>
{% else %}
<p>No active user sessions found.</p>
{% endif %}
