{# d_container_runtime_info.jinja2 — rich HTML #}
<p><b>📦 Container runtime</b></p>

<p><b>Container:</b> <code>{{ container_name|e }}</code></p>

<p><b>Health</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
<tr><td>Status</td><td>{{ health_badge|e }}</td></tr>
<tr><td>Failing streak</td><td>{{ health_failing_streak|e }}</td></tr>
<tr><td>Last check</td><td>{{ health_last_checked_at|e }}</td></tr>
<tr><td>Last output</td><td>{{ health_last_log|e }}</td></tr>
</table>

<p><b>Lifecycle</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
<tr><td>Created</td><td>{{ created_at|e }}</td></tr>
<tr><td>Started</td><td>{{ started_at|e }}</td></tr>
<tr><td>Finished</td><td>{{ finished_at|e }}</td></tr>
<tr><td>PID</td><td>{{ pid|e }}</td></tr>
<tr><td>Exit code</td><td>{{ exit_code|e }}</td></tr>
<tr><td>Stop signal</td><td>{{ stop_signal|e }}</td></tr>
<tr><td>Stop timeout</td><td>{{ stop_timeout|e }}</td></tr>
<tr><td>OOM killed</td><td>{{ oom_killed|e }}</td></tr>
<tr><td>Dead</td><td>{{ dead|e }}</td></tr>
<tr><td>State error</td><td>{{ state_error|e }}</td></tr>
</table>

<p><b>Security profile</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
<tr><td>Privileged</td><td>{{ privileged|e }}</td></tr>
<tr><td>Read-only rootfs</td><td>{{ read_only_rootfs|e }}</td></tr>
<tr><td>OOM kill disable</td><td>{{ oom_kill_disable|e }}</td></tr>
<tr><td>No new privileges</td><td>{{ no_new_privileges|e }}</td></tr>
<tr><td>Init process</td><td>{{ init_process|e }}</td></tr>
</table>

<p><b>Security options:</b></p>
{% if security_opts_count > 0 %}
<ul>
{% for option in security_opts %}
<li><code>{{ option|e }}</code></li>
{% endfor %}
</ul>
{% if hidden_security_opts_count > 0 %}
<p><i>... and {{ hidden_security_opts_count|e }} more security options</i></p>
{% endif %}
{% else %}
<p><code>none</code></p>
{% endif %}

<p><b>Linux capabilities</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
<tr><td>CapAdd</td><td>{{ (cap_add_text | default("none", true))|e }}</td></tr>
<tr><td>CapDrop</td><td>{{ (cap_drop_text | default("none", true))|e }}</td></tr>
</table>
