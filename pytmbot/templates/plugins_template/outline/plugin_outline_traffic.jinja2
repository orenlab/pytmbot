{# plugin_outline_traffic.jinja2 — rich HTML #}
{% set bytes_transferred = context['bytesTransferredByUserId'] %}
{% set user_names = context['userNames'] %}
<p><b>📶 Traffic by user</b></p>

{% if bytes_transferred %}
<table bordered striped compact>
<tr><th align="left">User</th><th align="right">Transferred</th></tr>
{% for user_id, bytes in bytes_transferred.items() %}
<tr><td>{{ user_names.get(user_id, 'Unknown')|e }} <i>#{{ user_id|e }}</i></td><td align="right">{{ set_naturalsize(bytes if bytes else 0)|e }}</td></tr>
{% endfor %}
</table>
{% else %}
<p><i>No traffic data yet.</i></p>
{% endif %}
