{# b_plugins.jinja2 — rich HTML #}
<p><b>{{ thought_balloon }} Hello, {{ first_name|e }}.</b></p>

<p><b>Available plugins</b></p>
<ul>
{% for plugin_name, plugin_description in plugins.items() %}
<li><b>{{ plugin_name|e }}</b>: {{ plugin_description|e }}</li>
{% endfor %}
</ul>

<p>Select a plugin below to open it.</p>
