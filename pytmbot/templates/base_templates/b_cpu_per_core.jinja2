{# templates/b_cpu_per_core.jinja2 — rich HTML #}
<p><b>{{ thought_balloon }} Per-Core CPU Load</b></p>

{% if context.core_rows %}
<table bordered striped>
<tr>
<th>Core</th>
<th>Usage</th>
<th align="right">%</th>
</tr>
{% for row in context.core_rows %}
<tr>
<td>{{ row.core|e }}</td>
<td><code>{{ row.bar|e }}</code></td>
<td align="right">{{ "%.1f"|format(row.usage_percent) }}%</td>
</tr>
{% endfor %}
</table>
{% else %}
<p>No per-core CPU data available.</p>
{% endif %}
