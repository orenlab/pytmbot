{# templates/docker_templates/d_images.jinja2 — rich HTML #}
<p><b>🖼️ Images</b></p>

{% for image in context.images %}
<p><b>{{ image.name|e }}</b></p>
<table bordered striped compact>
<tr><th align="left">Parameter</th><th align="left">Value</th></tr>
<tr><td>ID</td><td><code>{{ image.id|e }}</code></td></tr>
<tr><td>Tags{% if image.tags_count > 0 %} ({{ image.tags_count|e }}){% endif %}</td><td>{% if image.tags_count > 0 %}<code>{{ image.tags | map("e") | join(", ") }}</code>{% else %}<code>none</code>{% endif %}</td></tr>
<tr><td>Size</td><td>{{ image.size|e }}</td></tr>
<tr><td>Platform</td><td>{{ image.os|e }}/{{ image.architecture|e }}{% if image.variant != 'N/A' %} ({{ image.variant|e }}){% endif %}</td></tr>
<tr><td>Created</td><td>{{ image.created|e }}</td></tr>
</table>
{% else %}
<p>No images found.</p>
{% endfor %}
{% if context.images %}

<p><i>Tap an image below to open its details.</i></p>
{% endif %}
