{# templates/b_load_average.jinja2 — rich HTML #}
<p><b>{{ thought_balloon }} Load average</b></p>

<p><b>{{ desktop_computer }} Current values</b></p>
<table bordered striped>
<tr><th>Window</th><th align="right">Load</th></tr>
<tr><td>1 minute</td><td align="right">{{ context[0]|e }}</td></tr>
<tr><td>5 minutes</td><td align="right">{{ context[1]|e }}</td></tr>
<tr><td>15 minutes</td><td align="right">{{ context[2]|e }}</td></tr>
</table>
